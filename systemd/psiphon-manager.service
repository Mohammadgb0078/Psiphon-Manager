[Unit]
Description=Psiphon Multi-Instance Tunnel Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=%WORKING_DIR%
ExecStart=%NODE_PATH% %WORKING_DIR%/src/daemon.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psiphon-manager
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
